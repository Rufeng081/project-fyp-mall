# Copy this file to /etc/project-fyp-mall.env on the VM and fill in real values there.
# Do not commit the real /etc/project-fyp-mall.env file.

SERVER_PORT=9191
MALL_UPLOAD_DIR=/opt/project-fyp-mall/uploads

MYSQL_URL=jdbc:mysql://127.0.0.1:3306/electronic_mall?serverTimezone=GMT%2b8
MYSQL_USERNAME=mall_user
MYSQL_PASSWORD=change-me

REDIS_DATABASE=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Required for registration and forgot-password email verification codes.
# The backend sends the FYP-UKM R Mall Demo template through Brevo SMTP.
BREVO_SMTP_USERNAME=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
